# SPECTRE agent image: Python + Semgrep + Joern + AFL++.
#
# Build (from the spectre_swarm root):
#   docker build -f docker/Dockerfile.agent -t spectre-agent .
#
# Runs on Ubuntu 22.04 with Java 17 (Joern), clang/LLVM (AFL++ instrumentation)
# and the Python runtime for the LangGraph orchestrator.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1

# --- System dependencies -----------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        unzip \
        git \
        python3 \
        python3-pip \
        python3-venv \
        openjdk-17-jre-headless \
        clang \
        llvm \
        lld \
        gcc \
        g++ \
        make \
        cmake \
        pkg-config \
        afl++ \
    && rm -rf /var/lib/apt/lists/*

# --- Joern (Code Property Graph) --------------------------------------------
RUN mkdir -p /opt/joern \
    && wget -q "https://github.com/joernio/joern/releases/latest/download/joern-cli.zip" \
        -O /tmp/joern-cli.zip \
    && unzip -q /tmp/joern-cli.zip -d /opt/joern \
    && rm /tmp/joern-cli.zip

ENV PATH="/opt/joern/joern-cli:${PATH}"

# --- Python dependencies -----------------------------------------------------
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir semgrep

COPY . .

# Tool binaries are resolved at runtime via these defaults (overridable).
ENV SEMGREP_BIN=semgrep \
    JOERN_BIN=joern \
    JOERN_PARSE_BIN=joern-parse \
    AFL_FUZZ_BIN=afl-fuzz \
    AFL_CXX=afl-clang-fast++ \
    AFL_CC=afl-clang-fast

ENTRYPOINT ["python", "main.py"]
